{
  "name": "sulaksh-worker",
  "version": "1.0.0",
  "description": "SULAKSH backend ported to Cloudflare Workers + D1 (storage stays in Backblaze B2)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
