# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,https://sulaksh.example.com

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=12h
# httpOnly cookie name for the admin session
ADMIN_COOKIE_NAME=sulaksh_admin_token

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sulaksh-materials
# Optional: only needed if the bucket has a public dev/custom domain you want logged for reference.
# Presigned URLs are generated from R2_ACCOUNT_ID above regardless.
R2_PUBLIC_HOSTNAME=

# ---- Upload rules ----
MAX_FILE_SIZE_MB=25
PRESIGNED_URL_EXPIRY_SECONDS=300

# ---- Database ----
# Path to the SQLite file. Swap this layer for Postgres later without touching R2 logic.
DATABASE_PATH=./data/sulaksh.db
