# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,https://sulaksh.example.com

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=12h
# httpOnly cookie name for the admin session
ADMIN_COOKIE_NAME=sulaksh_admin_token

# ---- S3-compatible object storage (Backblaze B2 / Cloudflare R2) ----
# Endpoint examples:
#   Backblaze B2: https://s3.{region}.backblazeb2.com   (region from your bucket, e.g. us-west-002)
#   Cloudflare R2: https://{account_id}.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key
STORAGE_ENDPOINT=https://s3.us-west-002.backblazeb2.com
STORAGE_REGION=auto
STORAGE_BUCKET=sulaksh-materials
# Optional: only needed if the bucket has a public dev/custom domain you want logged for reference.
# Presigned URLs are generated from the endpoint above regardless.
STORAGE_PUBLIC_HOSTNAME=

# ---- Upload rules ----
MAX_FILE_SIZE_MB=25
PRESIGNED_URL_EXPIRY_SECONDS=300

# ---- Database ----
# Path to the SQLite file. Swap this layer for Postgres later without touching R2 logic.
DATABASE_PATH=./data/sulaksh.db
